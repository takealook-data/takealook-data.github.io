---
layout: null
permalink: /search.json
sitemap: false
---
{%- comment -%} noindex: true 인 글(본문 미작성)은 검색 인덱스에서 뺀다 {%- endcomment -%}
{%- assign published = site.posts | where_exp: "p", "p.noindex != true" -%}
[
{%- for post in published %}
  {
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | jsonify }},
    "excerpt": {{ post.excerpt | strip_html | strip_newlines | truncate: 200 | jsonify }},
    "categories": {{ post.categories | jsonify }},
    "tags": {% if post.tags %}{{ post.tags | jsonify }}{% else %}[]{% endif %},
    "date": "{{ post.date | date: "%Y-%m-%d" }}"
  }{% unless forloop.last %},{% endunless %}
{%- endfor %}
]
